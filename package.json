{
  "name": "@globalconnect/query",
  "version": "6.0.1",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "check:format": "prettier --config ./.prettierrc --check \"query/**/*{.ts,.js,.json,.css,.scss,.html}\"",
    "check:types": "tsc --noEmit -p ./tsconfig.lib.json && tsc --noEmit -p ./tsconfig.spec.json",
    "check:lint": "eslint -c .eslintrc.js  --ext .ts ./query --report-unused-disable-directives",
    "test": "npm run check:types && jest",
    "test:watch": "jest --watch --colors",
    "test:coverage": "npm run check:types && jest --coverage --colors --no-cache",
    "ci:publish": "npm run build && npm publish ./dist/query --access public"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/compiler-cli": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@types/jest": "29.5.1",
    "@types/node": "22.9.0",
    "@types/uuid": "9.0.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "jest": "30.4.2",
    "jest-preset-angular": "17.0.0",
    "ng-packagr": "21.2.5",
    "prettier": "3.5.3",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "zone.js": "0.15.1"
  },
  "peerDependencies": {
    "uuid": "9.0.0"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/test-setup.ts"
    ],
    "collectCoverageFrom": [
      "**/lib/**/*.ts",
      "!**/**module.ts",
      "!**/__fixtures__/**",
      "!**/lib/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 99,
        "branches": 96,
        "functions": 97,
        "lines": 99
      }
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  }
}
